      ],
      "source": [
        "fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(9, 7.5), sharex=True)\n",
        "for (i, j), c, nombre in [((0, 0), C1, \"Im τ11\"), ((0, 1), C2, \"Im τ12\"), ((1, 1), C3, \"Im τ22\")]:\n",
        "    ax1.plot(s_vals, Om_camino[:, i, j].imag, color=c, lw=2, marker=\"o\", ms=4, label=nombre)\n",
        "ax1.set_title(\"Ω calculada por Sage a lo largo de un camino continuo de superficies\", loc=\"left\", fontsize=12, fontweight=\"bold\")\n",
        "ax1.set_ylabel(\"entradas de Im Ω\", color=GRIS)\n",
        "ax1.legend(frameon=False, ncol=3, loc=\"upper left\")\n",
        "limpiar(ax1)\n",
        "for k in range(q_camino.shape[1]):\n",
        "    ax2.plot(s_vals, q_camino[:, k], color=C1, lw=1.5, alpha=0.8)\n",
        "ax2.set_title(\"Mismas superficies: las 10 theta-constantes pares, normalizadas y ordenadas\", loc=\"left\", fontsize=12, fontweight=\"bold\")\n",
        "ax2.set_ylabel(\"|θ| / máx |θ|\", color=GRIS)\n",
        "ax2.set_xlabel(\"posición en el camino (s = 0: e = (0, .15, .40, .80, 1, 2)   s = 1: e = (0, .45, .62, .90, 1, 2))\", color=GRIS)\n",
        "limpiar(ax2)\n",
        "fig.tight_layout(h_pad=2.5)\n",
        "fig.savefig(\"sage_saltos.png\", dpi=150, facecolor=\"white\")\n",
        "plt.show()\n"
      ],
      "id": "c10"
    },
